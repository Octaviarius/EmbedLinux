{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}",
        "env": {
            "SDK_ROOT": "${workspaceFolder}/${config:sdk.root}",
            "SDK_SYSROOT": "${config:sdk.sysroot}",
            "SDK_TOOLCHAIN_FILE": "${workspaceFolder}/${config:sdk.root}/${config:sdk.toolchainFile}",
            "SDK_GDB": "${config:sdk.gdb}",
            "SDK_TARGET_LOADER": "${config:sdk.targetLoader}",
            "SDK_TARGET_MULTIARCH": "${config:sdk.targetMultiarch}",
            "SDK_DEBUG_ARCH": "${config:sdk.debugArch}",
            "HOST_WORK_DIR": "${workspaceFolder}/${config:host.workDir}",
            "HOST_BUILD_DIR": "${workspaceFolder}/${config:host.workDir}/${config:host.buildDir}",
            "HOST_APP_PATH": "${workspaceFolder}/${config:host.workDir}/${config:host.buildDir}/${config:host.appPath}",
            "TARGET_SSH_HOST": "${config:target.sshHost}",
            "TARGET_WORK_DIR": "${config:target.workDir}",
            "TARGET_APP_PATH": "${config:target.workDir}/${config:target.appPath}",
            "TARGET_GDBSERVER": "${config:target.gdbserver}",
            "BUILD_TYPE": "${config:build.type}",
            "BUILD_JOBS": "${config:build.jobs}"
        }
    },
    "tasks": [
        {
            "label": "Show Environment Only",
            "type": "process",
            "command": "printenv",
            "args": [
                "SDK_ROOT",
                "HOST_WORK_DIR",
                "HOST_BUILD_DIR",
                "HOST_APP_PATH",
                "SDK_SYSROOT",
                "SDK_TOOLCHAIN_FILE",
                "SDK_GDB",
                "TARGET_SSH_HOST",
                "TARGET_WORK_DIR",
                "TARGET_APP_PATH",
                "SDK_DEBUG_ARCH"
            ],
            "problemMatcher": []
        },
        {
            "label": "Copy Sysroot Only",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/sysroot.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Fix Sysroot Links Only",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/fix-sysroot-links.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Configure Only",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/configure.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build Only",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/build.sh"
            ],
            "problemMatcher": "$gcc"
        },
        {
            "label": "Deploy Only",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/deploy.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run Only",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/run.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Console Only",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/debug-console.sh"
            ],
            "problemMatcher": {
                "owner": "target-console",
                "pattern": {
                    "regexp": "^(.+):(\\d+): (.+)$",
                    "file": 1,
                    "line": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Opening target console$",
                    "endsPattern": "^Target console ready$"
                }
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "Build",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Configure Only",
                "Build Only"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Deploy",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build",
                "Deploy Only"
            ],
            "problemMatcher": []
        },
        {
            "label": "Sync Sysroot",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Copy Sysroot Only",
                "Fix Sysroot Links Only"
            ],
            "problemMatcher": []
        },
        {
            "label": "Debug",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Deploy",
                "Console Only"
            ],
            "problemMatcher": []
        }
    ]
}
