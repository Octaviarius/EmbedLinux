{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}",
        "env": {
            "TARGET_HOST": "${config:target.host}",
            "TARGET_REMOTE_DIR": "${config:target.remoteDir}",
            "TARGET_BUILD_DIR": "${config:target.buildDir}",
            "TARGET_PROGRAM": "${config:target.program}",
            "TARGET_GDBSERVER": "${config:target.gdbserver}",
            "TARGET_LOADER": "${config:target.loader}",
            "CROSS_ARCH": "${config:cross.arch}",
            "CROSS_TRIPLE": "${config:cross.triple}",
            "CROSS_CC": "${config:cross.cc}",
            "CROSS_CXX": "${config:cross.cxx}",
            "CROSS_JOBS": "${config:cross.jobs}",
            "CROSS_BUILD_TYPE": "${config:cross.buildType}",
            "CROSS_BUILD_DIR": "${workspaceFolder}/${config:cross.buildDir}",
            "CROSS_SYSROOT": "${workspaceFolder}/${config:cross.sysroot}",
            "CROSS_TOOLCHAIN": "${workspaceFolder}/${config:cross.toolchain}"
        }
    },
    "tasks": [
        {
            "label": "Copy sysroot",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/sysroot.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Fix sysroot links",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/fix-sysroot-links.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Configure cross",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/configure.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Compile cross",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/build.sh"
            ],
            "problemMatcher": "$gcc"
        },
        {
            "label": "Prepare target",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/prepare.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Deploy program",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/deploy.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run on target",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/run.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Open target console",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/console.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build cross",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Configure cross",
                "Compile cross"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Deploy cross",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build cross",
                "Prepare target",
                "Deploy program"
            ],
            "problemMatcher": []
        },
        {
            "label": "Sync sysroot",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Copy sysroot",
                "Fix sysroot links"
            ],
            "problemMatcher": []
        }
    ]
}
