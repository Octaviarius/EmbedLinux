{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}",
        "env": {
            "TARGET_SSH_HOST": "${config:target.sshHost}",
            "TARGET_WORK_DIR": "${config:target.workDir}",
            "TARGET_APP_PATH": "${config:target.workDir}/${config:target.appPath}",
            "TARGET_GDBSERVER": "${config:target.gdbserver}",
            "TARGET_LOADER": "${config:target.loader}",
            "TARGET_LIB_TRIPLE": "${config:target.libTriple}",
            "HOST_WORK_DIR": "${workspaceFolder}/${config:host.workDir}",
            "HOST_BUILD_DIR": "${workspaceFolder}/${config:host.workDir}/${config:host.buildDir}",
            "HOST_APP_PATH": "${workspaceFolder}/${config:host.workDir}/${config:host.buildDir}/${config:host.appPath}",
            "HOST_SYSROOT": "${config:host.sysroot}",
            "HOST_TOOLCHAIN_FILE": "${workspaceFolder}/${config:host.workDir}/${config:host.toolchainFile}",
            "BUILD_TYPE": "${config:build.type}",
            "BUILD_JOBS": "${config:build.jobs}"
        }
    },
    "tasks": [
        {
            "label": "Copy sysroot",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/sysroot.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Fix sysroot links",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/fix-sysroot-links.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Configure cross",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/configure.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Compile cross",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/build.sh"
            ],
            "problemMatcher": "$gcc"
        },
        {
            "label": "Prepare target",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/prepare.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Deploy program",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/deploy.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run on target",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/run.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Open target console",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/console.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build cross",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Configure cross",
                "Compile cross"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Deploy cross",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build cross",
                "Prepare target",
                "Deploy program"
            ],
            "problemMatcher": []
        },
        {
            "label": "Sync sysroot",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Copy sysroot",
                "Fix sysroot links"
            ],
            "problemMatcher": []
        }
    ]
}
