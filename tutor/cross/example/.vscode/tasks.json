{
    "version": "2.0.0",
    "options": {
        "cwd": "${env:HOST_WORK_DIR}"
    },
    "tasks": [
        {
            "label": "Show development environment",
            "type": "process",
            "command": "printenv",
            "args": [
                "SDK_ROOT",
                "HOST_WORK_DIR",
                "HOST_BUILD_DIR",
                "HOST_APP_PATH",
                "SDK_SYSROOT",
                "SDK_TOOLCHAIN_FILE",
                "SDK_GDB",
                "TARGET_SSH_HOST",
                "TARGET_WORK_DIR",
                "TARGET_APP_PATH",
                "SDK_DEBUG_ARCH"
            ],
            "problemMatcher": []
        },
        {
            "label": "Copy sysroot",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/sysroot.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Fix sysroot links",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/fix-sysroot-links.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Configure cross",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/configure.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Compile cross",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/build.sh"
            ],
            "problemMatcher": "$gcc"
        },
        {
            "label": "Deploy program",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/deploy.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run on target",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/run.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Open target console",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/debug-console.sh"
            ],
            "problemMatcher": {
                "owner": "target-console",
                "pattern": {
                    "regexp": "^(.+):(\\d+): (.+)$",
                    "file": 1,
                    "line": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Opening target console$",
                    "endsPattern": "^Target console ready$"
                }
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "Build cross",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Configure cross",
                "Compile cross"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Deploy cross",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build cross",
                "Deploy program"
            ],
            "problemMatcher": []
        },
        {
            "label": "Sync sysroot",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Copy sysroot",
                "Fix sysroot links"
            ],
            "problemMatcher": []
        },
        {
            "label": "Debug target",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Deploy cross",
                "Open target console"
            ],
            "problemMatcher": []
        }
    ]
}
