{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cross: local GDB via SSH",
            "type": "cppdbg",
            "request": "launch",
            "program": "${env:HOST_APP_PATH}",
            "cwd": "${env:HOST_WORK_DIR}",
            "MIMode": "gdb",
            "miDebuggerPath": "${env:SDK_GDB}",
            "preLaunchTask": "Debug target",
            "setupCommands": [
                {
                    "text": "set sysroot ${env:SDK_SYSROOT}"
                }
            ],
            "customLaunchSetupCommands": [
                {
                    "text": "file \"${env:HOST_APP_PATH}\""
                },
                {
                    "text": "target remote | bash \"${env:HOST_WORK_DIR}/scripts/debug-transport.sh\""
                },
                {
                    "text": "tbreak main"
                }
            ],
            "launchCompleteCommand": "exec-continue",
            "targetArchitecture": "${env:SDK_DEBUG_ARCH}"
        }
    ]
}
