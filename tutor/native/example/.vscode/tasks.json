{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}",
        "env": {
            "TARGET_HOST": "${config:target.host}",
            "TARGET_REMOTE_DIR": "${config:target.remoteDir}",
            "TARGET_PROGRAM": "${config:target.program}",
            "TARGET_JOBS": "${config:target.jobs}",
            "TARGET_BUILD_TYPE": "${config:target.buildType}",
            "TARGET_BUILD_DIR": "${config:target.buildDir}"
        }
    },
    "tasks": [
        {
            "label": "Prepare target",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/prepare.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Sync sources",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/sync.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Configure target",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/configure.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Compile target",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/build.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run on target",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/run.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build on target",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Prepare target",
                "Sync sources",
                "Configure target",
                "Compile target"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Open target console",
            "type": "process",
            "command": "bash",
            "args": [
                "scripts/console.sh"
            ],
            "problemMatcher": []
        }
    ]
}
